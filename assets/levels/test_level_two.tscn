[sub_resource type="GDScript" id="GDScript_jjm7x"]
script/source = "extends Node3D


var scene_time := 0.0

var _travel_speed := 50.0

@onready var path_follow : PathFollow3D = find_child(\"PathFollow3D\")
@onready var path_follow_ahead : PathFollow3D = find_child(\"PathFollow3D_ahead\")
@onready var future_global_position_marker : MeshInstance3D = find_child(\"future_global_position_marker\")
@onready var future_local_position_marker : MeshInstance3D = find_child(\"future_local_position_marker\")
@onready var anim_player : AnimationPlayer = find_child(\"AnimationPlayer\")

@onready var camera : Camera3D = find_child(\"Camera3D\")

@onready var witness_camera_toggle : CheckButton = find_child(\"witness_camera_toggle\")
@onready var progress_ratio_label : Label = find_child(\"progress_ratio\")
@onready var tilt_label : Label = find_child(\"tilt_label\")
@onready var fps_label : Label = find_child(\"fps_label\")

@onready var main_camera : Camera3D = find_child(\"Camera3D\")
@onready var witness_camera : Camera3D = find_child(\"witness_camera\")

var has_looped := false

var last_path_position : Vector3


func _ready() -> void:
	pprint(\"_ready()\")

	#Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)

	#--
	anim_player.callback_mode_process = AnimationMixer.ANIMATION_CALLBACK_MODE_PROCESS_PHYSICS
	#--

	#$Player.global_position = camera.global_position * Vector3(1.0, 0.0, 1.0)
	$Player.global_position = path_follow.global_position * Vector3(1.0, 0.0, 1.0)
	last_path_position = path_follow.global_position


#func _process(delta: float) -> void:
func _physics_process(delta: float) -> void:
	scene_time += delta
	
	#path_follow.progress = scene_time * _travel_speed
	#pprint(\"path_follow.progress: %s\"%path_follow.progress)
	
	fps_label.text = \"fps: %3d\"%Engine.get_frames_per_second()
	
	progress_ratio_label.text = \"progress ratio: %0.3f\"%path_follow.progress_ratio
	if path_follow.progress_ratio >= 0.95 and not has_looped:
		#path_follow.progress_ratio  = 0.0
		has_looped = true


	#---------------------------------------------------------------------------
	# work out and drive \"PathFollow3D_ahead\" one frame ahead of the animation
	if not anim_player.current_animation.is_empty():
		var current_anim_name = anim_player.current_animation
		var animation : Animation = anim_player.get_animation(current_anim_name)
		var next_time = anim_player.current_animation_position + delta * 1.0 #5.0
		#pprint(\"--\")
		#pprint(anim_player.current_animation_position)
		#pprint(\"%0.3f (%0.4f)\"%[next_time, delta])
		var track_index = 0
		if track_index < animation.get_track_count() and animation.track_get_type( track_index ) == Animation.TYPE_BEZIER:
			var next_frame_value = animation.bezier_track_interpolate( track_index, next_time)
			# transform path_follow_ahead along the path
			path_follow_ahead.progress_ratio = next_frame_value
	
	
	#---------------------------------------------------------------------------
	# calculate corrective force to keep player in the action_area
	# 0 - future-frame mode: read AnimPlayer 1-frame-ahead fcurve onto a 2nd PathFollow3D
	# 1 - last-position-delta: current minus last position delta
	var corrective_method = 0
	match corrective_method:
		
		0:	#-- future-frame mode
			# current position in path_follow frame
			var current_local_position : Vector3 = path_follow.to_local($Player.global_position)
			# current position in future frame, to global space
			var future_global_position : Vector3 = path_follow_ahead.to_global( current_local_position )

			# -----------------------------------------------------------------
			# TODO: need to rotate the future global position
			# by the difference in u rotation of the current to future frame
			# -----------------------------------------------------------------

			# orange dot
			future_global_position_marker.global_position = future_global_position + Vector3(0.0, 1.0, 0.0)

			$Player.add_exo_direction( (future_global_position - $Player.global_position) * 0.5 ) # * 0.5 )
			
			# future global position in the local current frame
			var future_local_position : Vector3 = path_follow.to_local(future_global_position)
			
			# orange ring
			future_local_position_marker.position = future_local_position + Vector3(0.0, 1.0, 0.0)
			#future_local_position_marker.global_position = path_follow.to_global( future_local_position ) + Vector3(0.0, 1.0, 0.0)

			var yaw = -path_follow.global_basis.z
			yaw = - yaw.signed_angle_to( future_local_position - current_local_position, Vector3.UP )
			$Player.add_exo_yaw( yaw )
		
		1:	#-- method: current-last position delta
			var this_path_position = path_follow.global_position
			var path_delta = this_path_position - last_path_position
			last_path_position = this_path_position
			$Player.add_exo_direction( path_delta * Vector3(.75, 0.0, 0.4) )

			var level_path_rotation = Vector3(0.0, -1 * path_follow.transform.basis.z.signed_angle_to( Vector3.BACK, Vector3.UP ), 0.0)
			$Player.add_exo_yaw( level_path_rotation.y )
	#---------------------------------------------------------------------------


	tilt_label.text = \"tilt:%7.1f°\"%[ rad_to_deg($Player.rotation.z)]


func pprint(thing) -> void:
	print(\"[test level two] %s\"%thing)


func _on_witness_camera_toggle_toggled(toggled_on: bool) -> void:
	pprint(\"_on_witness_camera_toggle_toggled: %s\"%toggled_on)
	if toggled_on:
		witness_camera.make_current()
	else:
		main_camera.make_current()


func _input(event: InputEvent) -> void:
	if event is InputEventMouseButton:
		pprint(\"_input: %s (%s) (global:%s)\"%[event, event.position, event.global_position ])
	if event.is_action_pressed(\"ui_cancel\"):
		get_viewport().set_input_as_handled()
		get_tree().change_scene_to_file( \"res://globals/game.tscn\" )


func _on_witness_camera_toggle_mouse_entered() -> void:
	pprint(\"_on_witness_camera_toggle_mouse_entered\")
"

