[sub_resource type="GDScript" id="GDScript_ojkwq"]
script/source = "extends SubViewportContainer

func _ready() -> void:
	pprint(\"binding WindowManager events ..\")
	WindowManager.connect( \"change_fullscreen\", _on_windowmanager_change_fullscreen )
	pprint(\"HERE: %s\"%DisplayServer.window_get_size())
	_update_window_size()
	pprint(\"size: %s\"%self.size)


func _on_windowmanager_change_fullscreen( value ) -> void:
	_update_window_size()


func _update_window_size() -> void:
	var wsize : Vector2i = DisplayServer.window_get_size()
	self.size = wsize


func pprint(thing) -> void:
	print(\"[SubViewportContainer] %s\"%thing)
"

