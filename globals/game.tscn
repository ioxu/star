[sub_resource type="GDScript" id="GDScript_6dsdn"]
script/source = "extends TextureRect

@export var target_viewport: SubViewport


func _ready() -> void:
	#connect(\"gui_input\", _on_gui_input)
	pass


#func _input(event):
func _on_gui_input(event):
	if event is InputEventMouseButton or event is InputEventMouseMotion:
		if target_viewport != null:
			# it is possible to duplicate and alter the event
			# only if I need to modify the position of the event due to
			# resolution/space conversions between the SubViewport and
			# ViewportTexture
			#var new_event = event.duplicate() 
			
			#if event is InputEventMouseButton:
				#print(\"[ViewportDisplayTextureRect] : pushing event %s\"%[event])
			
			# forward event to the target
			target_viewport.push_input(event, true)

	# accept_event()
"

